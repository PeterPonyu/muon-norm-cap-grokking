{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PeterPonyu/muon-norm-cap-grokking/papers/figure-index.schema.json",
  "title": "Paper warehouse FIGURE-INDEX",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paper_id",
    "github",
    "zenodo_concept_doi",
    "pipeline",
    "figures"
  ],
  "properties": {
    "paper_id": { "const": "A" },
    "github": { "const": "PeterPonyu/muon-norm-cap-grokking" },
    "zenodo_concept_doi": {
      "type": "string",
      "pattern": "^10\\.5281/zenodo\\.[0-9]+$"
    },
    "pipeline": { "type": "string", "minLength": 1 },
    "figures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "generator",
          "summary",
          "preview_svg",
          "tex_build",
          "vec_build",
          "venue_flat_name"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^A_" },
          "label": { "type": "string", "pattern": "^fig:" },
          "generator": { "type": "string", "minLength": 1 },
          "summary": { "type": ["string", "null"] },
          "preview_svg": { "type": ["string", "null"] },
          "tex_build": { "type": "string", "minLength": 1 },
          "vec_build": { "type": "string", "minLength": 1 },
          "venue_flat_name": { "type": ["string", "null"] }
        }
      }
    }
  }
}
